  "steps": [
    "Mix flour, milk, water, egg white, yeast, sugar, and butter to form the dough.",
    "Let the dough cover and rise for about an hour.",
    "Flip the burger meat.",
    "Prepare the burger sauce by mixing mayonnaise, ketchup, mustard, and finely chopped gherkin pickles.",
    "Take a piece of dough and flatten it.",
    "Place the dough over a bowl.",
    "Add cheese.",
    "Add the first patty.",
    "Add the sauce.",
    "Add the pickles.",
    "Add the caramelized onion and bell pepper.",
    "Add meat and more cheese.",
    "Close the dough over the filling.",
    "Pinch the bottom and flip.",
    "Cover in egg yolk and sprinkle with sesame seeds.",
    "Cook at 360 for about 25 minutes or until golden brown."
  ],
