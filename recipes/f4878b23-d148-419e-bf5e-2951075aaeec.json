    },
    {
      "quantity": "",
      "unit": "",
      "item": "one egg white"
    },
    {
      "quantity": "",
      "unit": "",
      "item": "five grams of instant yeast"
    },
    {
      "quantity": "",
      "unit": "",
      "item": "one tablespoon of sugar"
    },
    {
      "quantity": "",
      "unit": "",
      "item": "two tablespoons of butter"
    },
    {
      "quantity": "",
      "unit": "",
      "item": "For the Burger Sauce:"
