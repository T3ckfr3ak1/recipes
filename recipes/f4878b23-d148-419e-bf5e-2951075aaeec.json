  "title": "Burger Buns with Burger Patty",
  "description": "A unique recipe that combines burger ingredients within a homemade bun, baked to golden brown perfection.",
  "servings": 1,
  "prep_minutes": 60,
  "cook_minutes": 25,
  "ingredients": [
